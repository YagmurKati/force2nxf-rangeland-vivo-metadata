# Copy to .env and edit.

export KUBECONFIG="/path/to/fonda/config.yml"
export NS=default
export DRIVER_POD=your-rangeland-driver-pod

export WORK_ROOT=/workspace/rangeland
export WORK_PVC=your-rangeland-work-pvc
export DATA_PVC=fonda-datasets
export SERVICE_ACCOUNT=default

export FORCE_IMAGE=yourdockerhub/force-dev-raster:latest
export FORCE_VERSION=3.6.5
export USE_CPU=4
export GROUP_SIZE=100
export MAX_RETRIES=5

export RUN_LABEL=force-rangeland-vivo
export INPUTDATA=/workspace/rangeland/FORCE2NXF-Rangeland/inputdata
export OUTDATA=/workspace/rangeland/outputdata
export RESULTS_DIR=/workspace/rangeland/results

# Set to 1 when the Kubernetes input data differs from the reference data.
export SKIP_CHECK_RESULTS=0

# Local Prometheus port-forward URL.
export PROM_URL=http://127.0.0.1:19090
export OUTPUT_TTL=metadata/force-rangeland-vivo.ttl

# Optional VIVO links.
export WORKFLOW_URI="http://example.org/vivo-import/run-metadata/workflow/long-term-vegetation-dynamics-in-the-mediterranean-force2nxf"
export PUBLICATION_URI="http://141.20.184.157:8080/vivo/individual/a1-publication-key-lehmann2021forceon"
export RUN_OPERATOR_URI=""
export RESPONSIBLE_RESEARCHER_URI="https://fonda.hu-berlin.de/?page_id=2066#FelixKummer"
export SUBPROJECT_URI="http://141.20.184.157:8080/vivo/individual/fonda-group-b5-transparent-multi-site-data-analysis-workflows-for-earth-observation"
export APPLICATION_DOMAIN_URI="http://172.28.33.178:8080/vivo/individual/n5261"
export BACKEND_URI="http://172.28.33.178:8080/vivo/individual/n5703"
